APP_ENV=development
DATA_DIR=./data
TIMEZONE=Asia/Seoul
DEFAULT_DURATION_MINUTES=60
# Minimum 8–12 sources; planner can increase this for the music provider duration cap.
MIN_TRACK_COUNT=8
CROSSFADE_SECONDS=2
DEFAULT_PRIVACY_STATUS=private
HUMAN_APPROVAL_REQUIRED=true
TEXT_PROVIDER=dummy
MUSIC_PROVIDER=dummy
IMAGE_PROVIDER=dummy
ENABLE_MUSIC_API=false
# Offline music job contract tests use explicit JobLimits; no paid API budget is configured.
# HTTP contract fixtures do not read MUSIC_API_KEY or enable a live transport.
ENABLE_IMAGE_API=false
ENABLE_YOUTUBE_UPLOAD=false
ENABLE_SCHEDULER=false
ENABLE_ANALYTICS_SYNC=false
# Reserved for future phases. No credentials are required or read by Phase 1.
OPENAI_API_KEY=
MUSIC_API_KEY=
IMAGE_API_KEY=
