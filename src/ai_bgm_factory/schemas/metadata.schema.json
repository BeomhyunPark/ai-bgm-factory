{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-bgm-factory:metadata:1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "category_id": {
      "type": "string",
      "minLength": 1
    },
    "default_language": {
      "type": "string",
      "minLength": 1
    },
    "privacy_status": {
      "const": "private"
    },
    "contains_synthetic_media": {
      "const": true
    },
    "made_for_kids": {
      "const": false
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "timestamp": {
            "type": "string",
            "pattern": "^([0-9]{2}:)?[0-9]{2}:[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "start_seconds",
          "timestamp",
          "title"
        ],
        "additionalProperties": false
      },
      "minItems": 8
    },
    "disclosure_note": {
      "type": "string",
      "minLength": 1
    },
    "intended_for_testing_only": {
      "const": true
    },
    "creative_distinctiveness": {
      "type": "object",
      "properties": {
        "concept_id": {
          "type": "string",
          "minLength": 1
        },
        "novelty_anchors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "similarity_score": {
          "type": "null"
        },
        "evaluation_status": {
          "const": "not_evaluated_test_fixture"
        }
      },
      "required": [
        "concept_id",
        "novelty_anchors",
        "similarity_score",
        "evaluation_status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "title",
    "description",
    "tags",
    "category_id",
    "default_language",
    "privacy_status",
    "contains_synthetic_media",
    "made_for_kids",
    "chapters",
    "disclosure_note",
    "intended_for_testing_only",
    "creative_distinctiveness"
  ],
  "additionalProperties": false
}
