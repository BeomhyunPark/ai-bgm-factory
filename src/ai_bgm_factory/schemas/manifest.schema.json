{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-bgm-factory:manifest:1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "created",
        "generating",
        "failed",
        "ready_for_review"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "seed": {
      "type": "integer"
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "config": {
      "type": "object"
    },
    "implementation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "running",
              "succeeded",
              "failed"
            ]
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "input_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "directory": {
            "type": "string",
            "minLength": 1
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "status",
          "attempt",
          "input_hash",
          "directory",
          "started_at"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "role",
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "review_scope": {
      "const": "local_test_only"
    },
    "publication": {
      "type": "object",
      "properties": {
        "privacy_status": {
          "const": "private"
        },
        "approval_required": {
          "const": true
        },
        "upload_eligible": {
          "const": false
        },
        "rights_status": {
          "const": "blocked"
        }
      },
      "required": [
        "privacy_status",
        "approval_required",
        "upload_eligible",
        "rights_status"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "stage",
        "reason",
        "type"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "created_at",
    "updated_at",
    "seed",
    "config_hash",
    "config",
    "implementation_sha256",
    "stages",
    "artifacts",
    "review_scope",
    "publication"
  ],
  "additionalProperties": false
}
